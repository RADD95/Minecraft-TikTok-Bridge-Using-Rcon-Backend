# Server port for Express
PORT=4567

# JWT secret used for auth tokens
JWT_SECRET=change-this-to-a-long-random-secret

# Allowed frontend origins for CORS, comma-separated
# Example: https://your-frontend.vercel.app,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Auth cookie behavior (important for cross-domain frontend/backend)
# same-site values: lax | strict | none
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
